rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isManager() {
      return isAuthenticated() && request.auth.token.email == "borjasiles3002@gmail.com";
    }

    function isStaff() {
      return isAuthenticated();
    }

    function validReservation(data) {
      return data.keys().hasAll(['id', 'nombre', 'fecha', 'personas', 'notas'])
        && data.keys().hasOnly(['id', 'nombre', 'fecha', 'personas', 'notas', 'status'])
        && data.id is string
        && data.nombre is string
        && data.fecha is string
        && data.personas is int
        && data.personas > 0
        && data.personas <= 30
        && data.notas is string
        && (!('status' in data) || data.status in ['pendiente', 'confirmada', 'rechazada', 'completada']);
    }

    match /employees/{employeeId} {
      allow read: if true;
      allow create, update, delete: if isManager();
    }

    match /messages/{messageId} {
      allow read, create, update: if isStaff();
      allow delete: if isManager();
    }

    match /drinkStock/{itemId} {
      allow read: if isStaff();
      allow write: if isManager();
    }

    match /kitchenStock/{itemId} {
      allow read: if isStaff();
      allow write: if isManager();
    }

    match /reservations/{reservationId} {
      allow create: if validReservation(request.resource.data);
      allow read, update, delete: if isStaff();
    }

    match /orders/{orderId} { allow read, write: if isStaff(); }
    match /tipsHistory/{docId} { allow read, write: if isStaff(); }
    match /expenseHistory/{docId} { allow read: if isStaff(); allow write: if isManager(); }
    match /salesHistory/{docId} { allow read, write: if isStaff(); }
    match /closingHistory/{docId} { allow read: if isStaff(); allow write: if isManager(); }
    match /purchaseHistory/{docId} { allow read: if isStaff(); allow write: if isManager(); }
    match /recipes/{docId} { allow read: if isStaff(); allow write: if isManager(); }
    match /elaborations/{docId} { allow read: if true; allow write: if isManager(); }
    match /inventoryTransactions/{docId} { allow read: if isStaff(); allow write: if isManager(); }
    match /menuAnalyses/{docId} { allow read: if isStaff(); allow write: if isManager(); }
    match /historicalData/{docId} { allow read: if isStaff(); allow write: if isManager(); }
    match /system/{docId} { allow read: if isStaff(); allow write: if isManager(); }
    match /test/{docId} { allow read: if isManager(); allow write: if false; }
  }
}
